# Copie para .env e preencha. O .env está no .gitignore — nunca comite token.

# --- Instagram -------------------------------------------------------------
# ID numérico da conta profissional do Instagram (não é o @usuario)
IG_USER_ID=
# Token de longa duração (60 dias) — veja docs/publicacao-automatica-instagram.md
IG_ACCESS_TOKEN=
# "facebook" (Facebook Login, exige Página) ou "instagram" (Instagram Login)
IG_LOGIN=facebook
# Confira a versão vigente no changelog da Meta antes de fixar
GRAPH_API_VERSION=v21.0

# --- Hospedagem das imagens (S3-compatible: R2, S3, B2, MinIO) -------------
S3_BUCKET=
S3_BASE_PUBLICA=https://pub-xxxxxxxx.r2.dev
S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
